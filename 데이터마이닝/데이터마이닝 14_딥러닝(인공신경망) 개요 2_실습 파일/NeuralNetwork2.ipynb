   "source": [
    "from sklearn.linear_model import Perceptron\n",
    "\n",
    "# <학습데이터의 입력과 정답> 입력\n",
    "X = [[0,0],[0,1],[1,0],[1,1]]\n",
    "y = [0, 0, 0, 1]\n",
    "\n",
    "# 퍼셉트론을 생성한다.\n",
    "clf = Perceptron()\n",
    "\n",
    "# 학습을 수행한다. \n",
    "clf.fit(X, y)\n",
    "\n",
    "# 테스트를 수행한다. \n",
    "test = [1, 1]\n",
    "print(clf.predict([test]))"
   ]
  }
 ],
